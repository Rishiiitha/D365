# Set these in your local process environment; never commit API keys.
# Copy to aiops-agent/.env to load automatically. Process variables take precedence.
LLM_PROVIDER=groq
LLM_MODEL=
# Set GROQ_API_KEY and GROQ_MODEL, or the generic LLM_API_KEY / LLM_MODEL.
GROQ_API_KEY=
GROQ_MODEL=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_PROMPT_BYTES=48000
LLM_MAX_REQUESTS=24
LLM_MAX_TOTAL_OUTPUT_TOKENS=48000
LLM_TIMEOUT_SECONDS=45
MAX_STEPS=5
# For a custom Chat Completions endpoint, use LLM_PROVIDER=openai_compatible.
# Choose a model supporting temperature 0..0.2 and JSON-object output mode.
